---
import { pageHref } from '../lib/site';

const pins = [
  { name: 'Nong Khiaw', href: '/nong-khiaw', x: 118, y: 78 },
  { name: 'Luang Prabang', href: '/luang-prabang', x: 108, y: 128 },
  { name: 'Vang Vieng', href: '/vang-vieng', x: 112, y: 176 },
  { name: 'Vientiane', href: '/vientiane', x: 104, y: 214 },
  { name: 'Pakse', href: '/pakse', x: 128, y: 300 },
  { name: 'Bolaven', href: '/bolaven-plateau', x: 156, y: 318 },
  { name: '4000 Islands', href: '/4000-islands', x: 132, y: 360 },
];
---
<svg class="map-svg map-laos map-home map-picked" viewBox="0 0 220 430" role="img" aria-label="Map of Laos with the towns in this guide">
  <path
    class="map-land"
    fill="#e7eef8"
    stroke="#0b3a82"
    stroke-width="2"
    d="M92 18 L128 12 L156 36 L148 78 L166 118 L150 168 L168 210 L146 258 L176 300 L168 348 L140 392 L112 404 L96 360 L78 300 L88 240 L70 190 L84 120 L74 62 Z"
  />
  {pins.map((pin) => (
    <a class="map-hit" href={pageHref(pin.href)}>
      <circle cx={pin.x} cy={pin.y} r="5" fill="#0b3a82" />
      <text x={pin.x + 8} y={pin.y + 4} font-size="11" fill="#161616">{pin.name}</text>
    </a>
  ))}
</svg>
